# Port the server listens on
PORT=3000

# --- LLM (optional but recommended) ---
# The agent works fully offline with deterministic templated questions/feedback
# if no key is provided. Set GROQ_API_KEY to unlock LLM-generated follow-up
# questions and richer, natural-language final feedback.
#
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
